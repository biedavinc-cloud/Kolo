{
  "name": "Transaction",
  "type": "object",
  "properties": {
    "household_id": {
      "type": "string",
      "title": "Foyer"
    },
    "account_id": {
      "type": "string",
      "title": "Compte"
    },
    "category_id": {
      "type": "string",
      "title": "Cat\u00e9gorie"
    },
    "profile_id": {
      "type": "string",
      "title": "Membre (user id)"
    },
    "amount": {
      "type": "number",
      "title": "Montant"
    },
    "type": {
      "type": "string",
      "enum": [
        "income",
        "expense"
      ],
      "default": "expense",
      "title": "Type"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Date"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "receipt_url": {
      "type": "string",
      "title": "URL du re\u00e7u"
    }
  },
  "required": [
    "household_id",
    "account_id",
    "amount",
    "type",
    "date"
  ],
  "rls": {
    "read": {
      "data.household_id": "{{user.data.household_id}}"
    },
    "create": {
      "data.household_id": "{{user.data.household_id}}"
    },
    "update": {
      "data.household_id": "{{user.data.household_id}}"
    },
    "delete": {
      "data.household_id": "{{user.data.household_id}}"
    }
  }
}